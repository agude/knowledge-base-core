# kb_search NAME [probe]: try NAME in every PATH directory, then in the
# fixed directories. Every directory, not `command -v`, so that a shim
# first on PATH does not hide a real interpreter after it.
kb_dirs=${KB_PYTHON_DIRS-/opt/homebrew/bin /usr/local/bin $HOME/.local/bin}
kb_search() {
    kb_ifs=$IFS
    IFS=:
    for kb_d in $PATH; do
        IFS=$kb_ifs
        kb_try "${kb_d:-.}/$1" "${2-}" && return 0
    done
    IFS=$kb_ifs
    for kb_d in $kb_dirs; do
        kb_try "$kb_d/$1" "${2-}" && return 0
    done
    return 1
}

if [ -f "$kb_root/.python-interpreter" ]; then
    IFS= read -r kb_line < "$kb_root/.python-interpreter" || :
    kb_try "$kb_line"
fi
kb_minor=20
while [ -z "$kb_py" ] && [ "$kb_minor" -ge 11 ]; do
    kb_search "python3.$kb_minor"
    kb_minor=$((kb_minor - 1))
done
[ -n "$kb_py" ] || kb_search python3 probe
[ -n "$kb_py" ] || kb_fail "knowledge base: needs Python 3.11 or newer; tried:${kb_tried:- no interpreter found}"
exec "$kb_py" -I "$kb_self" "$@"
