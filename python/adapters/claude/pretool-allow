# Find this file's real path and the repository root, choose a Python 3.11+
# interpreter, and run this file with it. See docs/python-port.md.
kb_self=$0
while [ -L "$kb_self" ]; do
    kb_link=$(readlink "$kb_self")
    case $kb_link in
        /*) kb_self=$kb_link ;;
        *) kb_self=$(dirname "$kb_self")/$kb_link ;;
    esac
