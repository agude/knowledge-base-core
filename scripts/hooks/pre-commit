#!/usr/bin/env bash
#
# pre-commit - Content-repo hook: lint staged articles and stamp `updated`.
#
# Installed into <content>/.git/hooks/pre-commit by scripts/install.
#
# Two jobs, both deterministic, which is why they belong in a hook rather
# than in a curator's memory:
#
# 1. Lint them. A second H1, a missing or malformed `verified`, or an
#    unclosed code fence corrupts retrieval, and none of it is visible by
#    eye. Errors reject the commit; warnings print and let it through. When
#    an article is moved or deleted, lint all knowledge articles so unchanged
#    inbound links to the old path are checked too.
#
# 2. Stamp `updated:` to today on every staged knowledge article. If the
#    content changed, the edit date is today; that is a fact. It is NOT
#    `verified:`, which asserts that someone confirmed the content still
#    holds — stamping that automatically would zero out `stale` forever.
#
# Lint runs FIRST. A hook that rewrites files and then rejects the commit
# leaves the author holding modified, staged files and a "rejected"
# message that never mentions them.
#
# Commits that stage no knowledge changes — every observe, ask, resolve, and
# archive — exit immediately.

set -uo pipefail

# Resolve the hook's real location to find the scripts directory.
self="$0"
while [[ -L "$self" ]]; do
    link="$(readlink "$self")"
    if [[ "$link" == /* ]]; then
        self="$link"
    else
        self="$(dirname "$self")/$link"
    fi
done
SCRIPTS_DIR="$(cd "$(dirname "$self")/.." && pwd -P)"

# The hook runs at the root of whichever content repo is committing, which
# is not necessarily the core repo's default ./content.
KB_CONTENT_DIR="$(git rev-parse --show-toplevel)"
export KB_CONTENT_DIR

# -z, not plain --name-only: under the default core.quotePath git quotes
# any path with non-ASCII bytes, and the quoted form matches nothing on
# disk — so knowledge/café.md was silently neither linted nor stamped.
STAGED=()
while IFS= read -r -d '' file; do
    case "$file" in
        *.md) if [[ -f "$file" ]]; then STAGED+=("$file"); fi ;;
    esac
done < <(git diff --cached -z --name-only --diff-filter=ACMR -- knowledge/)

# A staged Markdown rename or deletion can invalidate an unchanged article's
# inbound link or source reference. Such changes require a full knowledge-tree
# lint; ordinary edits retain the faster staged-file check.
topology_changed=false
if git diff --cached --quiet --diff-filter=DR -- knowledge/ sources/; then
    :
else
    diff_status=$?
    if [[ "$diff_status" -ne 1 ]]; then
        echo "pre-commit: could not inspect staged link-target paths." >&2
        exit 1
    fi
    topology_changed=true
fi

if [[ ${#STAGED[@]} -eq 0 && "$topology_changed" == false ]]; then
    exit 0
fi

# --- 1. Lint, before touching anything ---

if [[ "$topology_changed" == true ]]; then
    lint_args=(--path "$KB_CONTENT_DIR/knowledge")
else
    lint_args=("${STAGED[@]}")
fi

if ! "$SCRIPTS_DIR/lint" "${lint_args[@]}"; then
    echo "" >&2
    echo "pre-commit: lint errors — commit rejected, nothing modified." >&2
    exit 1
fi

# --- 2. Stamp updated: ---

TODAY="$(date -u +%Y-%m-%d)"

# A partial commit (`git commit -- <paths>`) runs against a temporary
# index, so anything the hook stages is discarded. Detect it and skip
# stamping rather than silently dropping the change.
partial=false
if [[ -n "${GIT_INDEX_FILE:-}" ]] && [[ "$GIT_INDEX_FILE" != *".git/index" ]]; then
    partial=true
fi

# current_updated - The `updated:` value from a real frontmatter block.
#
# Frontmatter is the block opened by `---` on line 1. Counting `---`
# anywhere also fires on a setext heading underline, and then the first
# later body line starting with `updated:` was rewritten as a date.
current_updated() {
    awk '
        NR == 1 { if ($0 !~ /^---[[:space:]]*$/) exit; next }
        /^---[[:space:]]*$/ { exit }
        /^updated:[[:space:]]*/ {
            sub(/^updated:[[:space:]]*/, "")
            print
            exit
        }
    ' "$1"
}

stamp_updated() {
    awk -v today="$TODAY" '
        NR == 1 { if ($0 !~ /^---[[:space:]]*$/) done = 1; print; next }
        !done && /^---[[:space:]]*$/ { done = 1; print; next }
        !done && /^updated:[[:space:]]*/ { print "updated: " today; next }
        { print }
    ' "$1"
}

stamped=0
for file in "${STAGED[@]}"; do
    current="$(current_updated "$file")"

    # No frontmatter, or no `updated:` to stamp. Lint reports a missing
    # field; inventing one is not this hook's job.
    if [[ -z "$current" || "$current" == "$TODAY" ]]; then
        continue
    fi

    if [[ "$partial" == true ]]; then
        echo "pre-commit: $file has updated: $current, not $TODAY" \
             "(partial commit — not stamping)" >&2
        continue
    fi

    # Write back through the existing inode. mktemp + mv would replace a
    # symlinked article with a regular file and carry mktemp's 0600 over
    # the article's own mode.
    tmp="$(mktemp)"
    if stamp_updated "$file" > "$tmp" && [[ -s "$tmp" ]]; then
        cat "$tmp" > "$file"
        git add -- "$file"
        stamped=$((stamped + 1))
    else
        echo "pre-commit: could not stamp $file, leaving it alone" >&2
    fi
    rm -f "$tmp"
done

if (( stamped > 0 )); then
    echo "pre-commit: stamped updated: $TODAY on $stamped article(s)"
fi

exit 0
