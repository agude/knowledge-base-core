#!/usr/bin/env bash
#
# session-context - Output the knowledge base context for session injection.
#
# Prints the KB topic map, live state, and any project-specific instruction
# file to stdout. Host adapters inject it using their own protocol.
#
# Usage: session-context

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/_lib.sh"

ROOT_INSTRUCTIONS="$(instruction_file "$REPO_ROOT")"
if [[ -n "$ROOT_INSTRUCTIONS" ]]; then
    cat "$ROOT_INSTRUCTIONS"
fi

echo ""
echo "## Topic areas (auto-generated)"
echo ""
"$SCRIPT_DIR/toc" --map 2>/dev/null || true

echo ""
echo "State: $("$SCRIPT_DIR/status" --brief 2>/dev/null || echo "unavailable")"

CONTENT_INSTRUCTIONS="$(instruction_file "$CONTENT_DIR")"
if [[ -n "$CONTENT_INSTRUCTIONS" ]]; then
    echo ""
    cat "$CONTENT_INSTRUCTIONS"
fi
