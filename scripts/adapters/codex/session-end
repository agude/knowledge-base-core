#!/usr/bin/env bash
# Codex SessionEnd adapter for the neutral session API.
set -euo pipefail

INPUT="$(cat)"
KB="${KNOWLEDGE_BASE:-}"
[[ -z "$KB" ]] && { echo '{}'; exit 0; }
[[ "${KNOWLEDGE_OBSERVE:-}" == "0" ]] && { echo '{}'; exit 0; }
command -v jq > /dev/null 2>&1 || { echo '{}'; exit 0; }

SESSION_ID="$(echo "$INPUT" | jq -r '.session_id // empty')"
if [[ -n "$SESSION_ID" ]]; then
    FILE="$("$KB/scripts/session-file" --session-id "$SESSION_ID" 2>/dev/null || echo "")"
    if [[ -n "$FILE" ]]; then
        # Run even when the buffer was swept: session-flush clears the durable
        # initialization marker before exiting on a missing file. Some hosts
        # impose a short shutdown deadline, so keep the flush asynchronous.
        "$KB/scripts/session-flush" "$FILE" </dev/null > /dev/null 2>&1 &
        disown 2>/dev/null || true
    fi
fi
echo '{}'
