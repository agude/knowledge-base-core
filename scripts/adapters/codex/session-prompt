#!/usr/bin/env bash
# Codex UserPromptSubmit adapter for the neutral session API.
set -euo pipefail

INPUT="$(cat)"
KB="${KNOWLEDGE_BASE:-}"
[[ -z "$KB" ]] && { echo '{}'; exit 0; }
[[ "${KNOWLEDGE_OBSERVE:-}" != "1" ]] && { echo '{}'; exit 0; }
command -v jq > /dev/null 2>&1 || { echo '{}'; exit 0; }

SESSION_ID="$(echo "$INPUT" | jq -r '.session_id // empty')"
PROMPT="$(echo "$INPUT" | jq -r '.prompt // empty')"
if [[ -n "$SESSION_ID" && -n "$PROMPT" ]]; then
    "$KB/scripts/session-append" --session-id "$SESSION_ID" \
        --role user --message "$PROMPT" 2>/dev/null || true
fi
echo '{}'
