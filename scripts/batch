#!/usr/bin/env bash
#
# batch - Create and inspect a curation batch.
#
# Usage:
#   batch start
#   batch start --files FILENAME [FILENAME ...]
#   batch status BATCH_ID
#   batch defer BATCH_ID FILENAME

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"

BATCH_DIR="$CONTENT_DIR/observations/batches"
PENDING_DIR="$CONTENT_DIR/observations/pending"
MAX_BATCH_REPORT_ITEMS=8

die() { echo "Error: $*" >&2; exit 1; }

fail_locked() {
    release_lock
    die "$*"
}

batch_file() {
    local id="$1"
    [[ "$id" != */* && "$id" == *.tsv ]] || die "invalid batch id: $id"
    echo "$BATCH_DIR/$id"
}

start_batch() {
    local explicit=false
    local -a selected=()
    local name seen path

    if (( $# == 0 )); then
        :
    elif [[ "$1" == --files ]]; then
        shift
        (( $# > 0 )) || die "--files requires at least one filename"
        explicit=true
        for name in "$@"; do
            [[ "$name" != */* ]] || die "not a pending filename: $name"
            [[ "$name" == *.md ]] || die "not a markdown filename: $name"
            for seen in "${selected[@]}"; do
                [[ "$seen" != "$name" ]] || die "duplicate filename: $name"
            done
            selected+=("$name")
        done
    else
        die "usage: batch start [--files FILENAME [FILENAME ...]]"
    fi

    acquire_lock || exit 1
    mkdir -p "$BATCH_DIR"
    local id
    id="$(date -u +%Y%m%dT%H%M%S)-$$.tsv"
    local file="$BATCH_DIR/$id"

    if [[ "$explicit" == true ]]; then
        for name in "${selected[@]}"; do
            path="$PENDING_DIR/$name"
            [[ -f "$path" ]] || fail_locked "pending observation not found: $name"
        done
    else
        while IFS= read -r -d '' path; do
            selected+=("$(basename "$path")")
        done < <(find "$PENDING_DIR" -maxdepth 1 -name '*.md' -type f -print0 | sort -z)
    fi

    if (( ${#selected[@]} == 0 )); then
        rm -f "$file"
        release_lock
        die "no pending observations"
    fi

    {
        echo $'filename\toriginal_sha256\tstatus\tdisposition\tdestination'
        for name in "${selected[@]}"; do
            path="$PENDING_DIR/$name"
            printf '%s\t%s\tpending\t\t\n' "$name" "$(sha256sum "$path" | awk '{print $1}')"
        done
    } > "$file"
    echo "Created batch: $id"
    echo "Selected: $(( $(wc -l < "$file") - 1 )) observation(s)"
    release_lock
}

record_destination() {
    local destination="$1" index

    for index in "${!destination_names[@]}"; do
        if [[ "${destination_names[index]}" == "$destination" ]]; then
            destination_counts[index]=$((destination_counts[index] + 1))
            return 0
        fi
    done
    destination_names+=("$destination")
    destination_counts+=(1)
}

status_batch() {
    acquire_lock || exit 1
    local file="$1" line name hash status disposition destination path actual
    local incorporated=0 duplicate=0 ephemeral=0 invalid_disposition=0
    local -a destination_names=()
    local -a destination_counts=()
    local -a deferred_names=()
    [[ -f "$file" ]] || die "batch not found: $(basename "$file")"
    local pending=0 complete=0 deferred=0 invalid=0
    while IFS=$'\t' read -r name hash status disposition destination; do
        [[ "$name" == filename ]] && continue
        path="$PENDING_DIR/$name"
        if [[ "$status" == pending && -f "$path" ]]; then
            actual="$(sha256sum "$path" | awk '{print $1}')"
            if [[ "$actual" != "$hash" ]]; then
                echo "CHANGED: observations/pending/$name"; invalid=$((invalid + 1))
            else
                pending=$((pending + 1))
            fi
        elif [[ "$status" == complete || "$status" == deferred ]]; then
            if [[ "$status" == complete && ! -f "$CONTENT_DIR/observations/archived/$name" ]]; then
                echo "MISSING ARCHIVE: observations/archived/$name"; invalid=$((invalid + 1))
            elif [[ "$status" == deferred && ! -f "$path" ]]; then
                echo "MISSING DEFERRED INPUT: observations/pending/$name"; invalid=$((invalid + 1))
            else
                if [[ "$status" == complete ]]; then
                    complete=$((complete + 1))
                    case "$disposition" in
                        incorporated)
                            incorporated=$((incorporated + 1))
                            [[ -n "$destination" ]] && record_destination "$destination"
                            ;;
                        duplicate) duplicate=$((duplicate + 1)) ;;
                        ephemeral) ephemeral=$((ephemeral + 1)) ;;
                        *)
                            invalid_disposition=$((invalid_disposition + 1))
                            invalid=$((invalid + 1))
                            ;;
                    esac
                else
                    deferred=$((deferred + 1))
                    if (( ${#deferred_names[@]} < MAX_BATCH_REPORT_ITEMS )); then
                        deferred_names+=("$name")
                    fi
                fi
            fi
        else
            echo "INVALID STATUS: $name ($status)"; invalid=$((invalid + 1))
        fi
    done < "$file"
    release_lock
    echo "Batch $(basename "$file"): $complete complete, $pending pending, $deferred deferred"
    echo "  Dispositions: incorporated=$incorporated, duplicate=$duplicate, ephemeral=$ephemeral"
    if (( invalid_disposition > 0 )); then
        echo "  Dispositions not recognized: $invalid_disposition"
    fi
    if (( ${#destination_names[@]} == 0 )); then
        echo "  Destinations: none"
    else
        echo "  Destinations:"
        local index displayed=0
        for index in "${!destination_names[@]}"; do
            printf "    %s (%d item(s))\n" "${destination_names[index]}" "${destination_counts[index]}"
            displayed=$((displayed + 1))
            (( displayed >= MAX_BATCH_REPORT_ITEMS )) && break
        done
        if (( ${#destination_names[@]} > MAX_BATCH_REPORT_ITEMS )); then
            echo "    ... $(( ${#destination_names[@]} - MAX_BATCH_REPORT_ITEMS )) more destination(s)"
        fi
    fi
    if (( deferred == 0 )); then
        echo "  Deferred work: none"
    else
        echo "  Deferred work: $deferred item(s)"
        for index in "${!deferred_names[@]}"; do
            echo "    - ${deferred_names[index]}"
        done
        if (( deferred > ${#deferred_names[@]} )); then
            echo "    ... $((deferred - ${#deferred_names[@]})) more deferred item(s)"
        fi
    fi
    (( invalid == 0 )) || { echo "Batch requires attention: $invalid invalid item(s)." >&2; return 1; }
}

defer_item() {
    local file="$1" name="$2" tmp row hash status actual
    [[ "$name" != */* ]] || die "not a pending filename: $name"
    acquire_lock || exit 1
    row="$(awk -F '\t' -v n="$name" '$1 == n { print; found=1 } END { if (!found) exit 1 }' "$file")" || die "item is not a member of batch: $name"
    IFS=$'\t' read -r _ hash status _ _ <<< "$row"
    [[ "$status" == pending ]] || die "item is already completed or deferred: $name"
    [[ -f "$PENDING_DIR/$name" ]] || die "pending input is missing: $name"
    actual="$(sha256sum "$PENDING_DIR/$name" | awk '{print $1}')"
    [[ "$actual" == "$hash" ]] || die "input changed since batch selection: observations/pending/$name"
    tmp="$(mktemp)"
    awk -F '\t' -v n="$name" 'BEGIN { OFS="\t" } NR == 1 { print; next } $1 == n { $3="deferred"; $4="deferred"; found=1 } { print } END { if (!found) exit 1 }' "$file" > "$tmp" || { rm -f "$tmp"; die "item is not pending in batch: $name"; }
    mv "$tmp" "$file"
    release_lock
    echo "Deferred: $name"
}

case "${1:-}" in
    start) shift; start_batch "$@" ;;
    status) shift; [[ $# -eq 1 ]] || die "usage: batch status BATCH_ID"; status_batch "$(batch_file "$1")" ;;
    defer) shift; [[ $# -eq 2 ]] || die "usage: batch defer BATCH_ID FILENAME"; defer_item "$(batch_file "$1")" "$2" ;;
    -h|--help) show_help "$0" ;;
    *) die "usage: batch {start|status BATCH_ID|defer BATCH_ID FILENAME}" ;;
esac
