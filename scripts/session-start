#!/usr/bin/env bash
#
# session-start - SessionStart hook for the knowledge base.
#
# Called by Claude Code's SessionStart hook. Does three things:
# 1. Creates a session-specific observation buffer file.
# 2. Sets KNOWLEDGE_OBSERVE=1 and KNOWLEDGE_SESSION_FILE via CLAUDE_ENV_FILE.
# 3. Outputs the knowledge base CLAUDE.md to stdout (injected into context).
#
# Also processes any orphaned session files from crashed sessions.
#
# Input: JSON on stdin with session_id, transcript_path, etc.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Read hook input (must consume stdin before any early exit)
INPUT="$(cat)"

source "$SCRIPT_DIR/_lib.sh"

SESSION_DIR="$(session_dir)"
# Buffers written before the directory moved out of shared /tmp.
LEGACY_SESSION_DIR="/tmp/knowledge-sessions"

# Output CLAUDE.md, the topic map, live state, and project context.
#
# The map, not the full topic list: `toc --depth 1` costs three lines per
# article and grew with the base, reaching 8.4 KB at 128 articles for a
# payload identical in every session. Areas and counts cost 770 bytes and
# a session drills in with `toc --path <area>`.
output_context() {
    if [[ -f "$REPO_ROOT/CLAUDE.md" ]]; then
        cat "$REPO_ROOT/CLAUDE.md"
    fi
    echo ""
    echo "## Topic areas (auto-generated)"
    echo ""
    "$SCRIPT_DIR/toc" --map 2>/dev/null || true
    echo ""
    echo "State: $("$SCRIPT_DIR/status" --brief 2>/dev/null || echo "unavailable")"
    if [[ -f "$CONTENT_DIR/CLAUDE.md" ]]; then
        echo ""
        cat "$CONTENT_DIR/CLAUDE.md"
    fi
}

# Capture setup must never suppress the injection. A session without an
# observation buffer still works; a session without the knowledge base
# does not. Under `set -e` any failure below — a missing jq, an
# unwritable session directory — exited before output_context ever ran,
# and the hook produced zero bytes. Emit on the way out, whatever
# happened.
trap 'output_context; exit 0' EXIT

# Respect a pre-existing KNOWLEDGE_OBSERVE=0 (launch with
# KNOWLEDGE_OBSERVE=0 claude to suppress all observation for a session).
if [[ "${KNOWLEDGE_OBSERVE:-}" == "0" ]]; then
    if [[ -n "${CLAUDE_ENV_FILE:-}" ]]; then
        echo "KNOWLEDGE_OBSERVE=0" >> "$CLAUDE_ENV_FILE"
    fi
    exit 0
fi

# jq parses the hook payload. Without it there is no session id and so no
# capture, but the context still goes out.
if ! command -v jq > /dev/null 2>&1; then
    logger -t knowledge "session-start: jq not found, capture disabled" 2>/dev/null || true
    exit 0
fi

SESSION_ID="$(echo "$INPUT" | jq -r '.session_id // empty' 2>/dev/null || echo "")"

if [[ -z "$SESSION_ID" ]]; then
    # Fallback when session_id is missing from the payload
    SESSION_ID="$$-$(date +%s)"
fi

# Ensure session directory exists and is ours alone
if ! ensure_session_dir "$SESSION_DIR"; then
    logger -t knowledge "session-start: cannot use $SESSION_DIR, capture disabled" 2>/dev/null || true
    exit 0
fi

# Process orphaned session files from crashed sessions, including any
# left in the old shared-/tmp location by a previous version.
#
# The legacy directory lives in shared /tmp, so it is swept only when we
# own it, and symlinks are skipped everywhere: -O follows the link and
# reports on the target, so a planted symlink to a file the user owns
# would have been read straight into a committed observation.
SWEEP_DIRS=("$SESSION_DIR")
if [[ -d "$LEGACY_SESSION_DIR" && -O "$LEGACY_SESSION_DIR" && ! -L "$LEGACY_SESSION_DIR" ]]; then
    SWEEP_DIRS+=("$LEGACY_SESSION_DIR")
fi

for dir in "${SWEEP_DIRS[@]}"; do
    for orphan in "$dir"/session-*.jsonl; do
        [[ -f "$orphan" ]] || continue
        if [[ -L "$orphan" ]]; then continue; fi
        [[ -O "$orphan" ]] || continue
        # Skip our own (shouldn't exist yet, but be safe)
        if [[ "$orphan" == "$SESSION_DIR/session-${SESSION_ID}.jsonl" ]]; then
            continue
        fi

        # Check if the file is older than 1 hour (likely orphaned)
        if [[ "$(find "$orphan" -mmin +60 2>/dev/null)" ]]; then
            # Process orphaned observations
            "$SCRIPT_DIR/session-flush" "$orphan" 2>/dev/null || true
        fi
    done
done

# Create session file. touch, not truncate: a resumed or cleared session
# fires SessionStart again with the same id and must keep its buffer.
SESSION_FILE="$SESSION_DIR/session-${SESSION_ID}.jsonl"
touch "$SESSION_FILE"
chmod 600 "$SESSION_FILE" 2>/dev/null || true

# Set environment variables for the session
if [[ -n "${CLAUDE_ENV_FILE:-}" ]]; then
    echo "KNOWLEDGE_OBSERVE=1" >> "$CLAUDE_ENV_FILE"
    echo "KNOWLEDGE_SESSION_FILE=$SESSION_FILE" >> "$CLAUDE_ENV_FILE"
    logger -t knowledge "session-start: set KNOWLEDGE_OBSERVE=1 for $SESSION_ID" 2>/dev/null || true
else
    logger -t knowledge "session-start: CLAUDE_ENV_FILE not set, cannot export KNOWLEDGE_OBSERVE" 2>/dev/null || true
fi

# output_context runs from the EXIT trap.
