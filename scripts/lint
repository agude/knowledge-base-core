#!/usr/bin/env bash
#
# lint - Check knowledge articles against the structural conventions.
#
# Retrieval assumes every article has one H1, carries a parseable verified
# date, and splits into H2 sections small enough to be worth loading.
# Nothing enforced that, so drift surfaced only as bad answers: a second
# H1 turns one article into two topics in `toc`, and an unclosed code
# fence hides every heading after it from both `toc` and `section`.
#
# Run during curation and after bulk edits.
#
# Usage:
#   lint [PATH ...] [--max-lines N] [--strict] [--batch BATCH_ID]
#
# Options:
#   --path PATH     Directory or file to check (repeatable; also positional)
#   --max-lines N   Warn when an H2 exceeds N lines (default: 50)
#   --strict        Treat warnings as errors
#   --batch ID      During curation, allow a source reference to an archived
#                   observation selected by this batch while it is pending
#
# With no path, checks knowledge/.
#
# Checks:
#   error    no H1, or more than one H1
#   error    frontmatter missing title, updated, or verified
#   error    verified is not a YYYY-MM-DD date
#   error    a code fence is left open at end of file
#   error    a local Markdown link or source reference is missing
#   error    a local Markdown link's heading anchor is missing
#   warning  an H2 exceeds --max-lines
#   warning  two H2s in one file share the same text (--heading picks the
#            first silently)
#
# Exit status:
#   0  clean
#   1  at least one error, or any warning under --strict
#
# Examples:
#   lint
#   lint --path knowledge/home/
#   lint knowledge/home/insulation.md --max-lines 40
#   lint knowledge/a.md knowledge/b.md

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"

TARGETS=()
MAX_LINES=50
STRICT=false
BATCH=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --path|--file) need_arg "$1" $#; TARGETS+=("$2"); shift 2 ;;
        --max-lines)   need_arg "$1" $#; MAX_LINES="$2"; shift 2 ;;
        --strict)      STRICT=true; shift ;;
        --batch)       need_arg "$1" $#; BATCH="$2"; shift 2 ;;
        -h|--help)
            show_help "$0"
            exit 0
            ;;
        -*) echo "Unknown option: $1" >&2; exit 1 ;;
        *)  TARGETS+=("$1"); shift ;;
    esac
done

if [[ ! "$MAX_LINES" =~ ^[0-9]+$ ]]; then
    echo "Error: --max-lines takes a number" >&2
    exit 1
fi

BATCH_FILE=""
if [[ -n "$BATCH" ]]; then
    if [[ "$BATCH" == */* || "$BATCH" != *.tsv ]]; then
        echo "Invalid batch id: $BATCH" >&2
        exit 1
    fi
    BATCH_FILE="$CONTENT_DIR/observations/batches/$BATCH"
    if [[ ! -f "$BATCH_FILE" ]]; then
        echo "Batch not found: $BATCH" >&2
        exit 1
    fi
fi

if [[ ${#TARGETS[@]} -eq 0 ]]; then
    TARGETS=("$CONTENT_DIR/knowledge")
fi

FILES=()
for target in "${TARGETS[@]}"; do
    if [[ ! -e "$target" ]]; then
        # Report the path the caller gave us, not a set -e exit, when
        # resolve_path cannot place it.
        if resolved="$(resolve_path "$target")"; then
            target="$CONTENT_DIR/$resolved"
        fi
    fi

    # Constrain existing targets as well as paths resolved from content-relative
    # names. The former path skipped this check, allowing an absolute file or
    # an in-root symlink to an external file to be read below.
    if ! path_is_contained "$target"; then
        echo "Path outside content root: $target" >&2
        exit 1
    fi

    if [[ -d "$target" ]]; then
        while IFS= read -r -d '' f; do
            FILES+=("$f")
        done < <(find "$target" -name '*.md' -type f -print0 | sort -z)
    elif [[ -f "$target" ]]; then
        FILES+=("$target")
    else
        echo "Not found: $target" >&2
        exit 1
    fi
done

errors=0
warnings=0

err() {
    errors=$((errors + 1))
    printf "  error    %s:%s  %s\n" "$1" "$2" "$3"
}

warn() {
    warnings=$((warnings + 1))
    printf "  warning  %s:%s  %s\n" "$1" "$2" "$3"
}

is_external_url() {
    local target="$1"

    [[ "$target" == //* ]] \
        || [[ "$target" =~ ^[A-Za-z][A-Za-z0-9+.-]*: ]]
}

trim_whitespace() {
    local value="$1"

    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    printf '%s' "$value"
}

link_destination() {
    local value

    value="$(trim_whitespace "$1")"
    if [[ "$value" == \<* ]]; then
        value="${value#<}"
        value="${value%%>*}"
    else
        value="${value%%[[:space:]]*}"
    fi
    printf '%s' "$value"
}

heading_slug() {
    # Anchors use the supported ASCII GitHub-style heading slug: lowercase,
    # punctuation removed, whitespace converted to hyphens.
    printf '%s' "$1" \
        | LC_ALL=C tr '[:upper:]' '[:lower:]' \
        | LC_ALL=C sed -E \
            's/[^a-z0-9 _-]//g; s/[[:space:]]+/-/g; s/-+/-/g; s/^-+//; s/-+$//'
}

heading_has_anchor() {
    local file="$1" expected="$2" line

    md_heading_reset
    while IFS= read -r line || [[ -n "$line" ]]; do
        md_heading "$line" || continue
        [[ "$(heading_slug "$MD_HEADING_TEXT")" == "$expected" ]] \
            && return 0
    done < "$file"
    return 1
}

batch_has_pending_observation() {
    local name="$1" row original_sha status pending_file actual_sha

    [[ -n "$BATCH_FILE" && "$name" != */* ]] || return 1
    row="$(awk -F '\t' -v n="$name" \
        '$1 == n { print; found=1 } END { if (!found) exit 1 }' \
        "$BATCH_FILE")" || return 1
    IFS=$'\t' read -r _ original_sha status _ _ <<< "$row"
    [[ "$status" == pending ]] || return 1

    pending_file="$CONTENT_DIR/observations/pending/$name"
    [[ -f "$pending_file" ]] || return 1
    actual_sha="$(sha256_file "$pending_file")"
    [[ "$actual_sha" == "$original_sha" ]]
}

source_reference_can_be_pending() {
    local source_path="$1" name

    [[ "$source_path" == observations/archived/*.md ]] || return 1
    name="${source_path#observations/archived/}"
    batch_has_pending_observation "$name"
}

check_source_reference() {
    local file="$1" rel="$2" line_number="$3" reference="$4"
    local source_path fragment target

    is_external_url "$reference" && return 0
    [[ "$reference" == *.md || "$reference" == *.md#* ]] || return 0

    source_path="${reference%%#*}"
    fragment=""
    [[ "$reference" == *#* ]] && fragment="${reference#*#}"

    if [[ "$source_path" == /* ]]; then
        err "$rel" "$line_number" \
            "absolute local source reference is unsupported: $reference"
        return 0
    fi

    target="$CONTENT_DIR/$source_path"
    if ! path_is_contained "$target"; then
        err "$rel" "$line_number" \
            "local source reference escapes content root: $reference"
        return 0
    fi

    if [[ ! -f "$target" ]]; then
        if source_reference_can_be_pending "$source_path"; then
            return 0
        fi
        err "$rel" "$line_number" "missing local source reference: $reference"
        return 0
    fi

    if [[ -n "$fragment" && "$target" == *.md ]]; then
        fragment="$(printf '%s' "$fragment" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
        if ! heading_has_anchor "$target" "$fragment"; then
            err "$rel" "$line_number" \
                "missing source reference anchor '#$fragment': $reference"
        fi
    fi
}

# shellcheck disable=SC2094  # anchor validation may reread the input file
check_source_references() {
    local file="$1" rel="$2"
    local line lineno=0 in_frontmatter=false in_sources=false value

    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        if [[ "$line" == "---" ]]; then
            if [[ "$in_frontmatter" == false ]]; then
                in_frontmatter=true
            else
                break
            fi
            continue
        fi
        [[ "$in_frontmatter" == true ]] || continue

        if [[ "$line" =~ ^sources:[[:space:]]*$ ]]; then
            in_sources=true
            continue
        fi
        if [[ "$in_sources" == true ]]; then
            if [[ "$line" =~ ^[[:space:]]*-[[:space:]]+(.*)$ ]]; then
                value="${BASH_REMATCH[1]}"
                if [[ "$value" =~ ^\"(.*)\"$ ]]; then
                    value="${BASH_REMATCH[1]}"
                    value="${value//\\\"/\"}"
                    value="${value//\\\\/\\}"
                fi
                # The anchor check may read this same file for a self-reference.
                # shellcheck disable=SC2094
                check_source_reference "$file" "$rel" "$lineno" "$value"
                continue
            fi
            in_sources=false
        fi
    done < "$file"
}

check_local_link() {
    local file="$1" rel="$2" line_number="$3" raw_destination="$4"
    local destination path fragment target

    destination="$(link_destination "$raw_destination")"
    [[ -n "$destination" ]] || return 0
    is_external_url "$destination" && return 0

    path="${destination%%#*}"
    fragment=""
    [[ "$destination" == *#* ]] && fragment="${destination#*#}"

    if [[ "$path" == /* ]]; then
        err "$rel" "$line_number" \
            "absolute local Markdown link is unsupported: $destination"
        return 0
    fi

    if [[ -n "$path" ]]; then
        target="$(dirname "$file")/$path"
    else
        target="$file"
    fi

    if ! path_is_contained "$target"; then
        err "$rel" "$line_number" \
            "local Markdown link escapes content root: $destination"
        return 0
    fi
    if [[ ! -f "$target" ]]; then
        err "$rel" "$line_number" "missing local Markdown link target: $destination"
        return 0
    fi

    if [[ -n "$fragment" && "$target" == *.md ]]; then
        fragment="$(printf '%s' "$fragment" | LC_ALL=C tr '[:upper:]' '[:lower:]')"
        if ! heading_has_anchor "$target" "$fragment"; then
            err "$rel" "$line_number" \
                "missing local Markdown link anchor '#$fragment': $destination"
        fi
    fi
}

# shellcheck disable=SC2094  # anchor validation may reread the input file
check_local_links() {
    local file="$1" rel="$2"
    local line lineno=0 in_frontmatter=false frontmatter_done=false
    local remaining match raw_destination
    local link_pattern='\[[^]]+\]\(([^)]*)\)'

    md_heading_reset
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        if [[ "$line" == "---" && "$frontmatter_done" == false ]]; then
            if [[ "$in_frontmatter" == false ]]; then
                in_frontmatter=true
            else
                in_frontmatter=false
                frontmatter_done=true
            fi
            continue
        fi
        [[ "$frontmatter_done" == true ]] || continue

        _md_fence_track "$line" && continue
        [[ "$MD_FENCE_OPEN" == false ]] || continue

        # Inline code is not rendered as a link. This also keeps examples such
        # as `[text](page.md)` from being treated as repository references.
        # shellcheck disable=SC2016  # backticks are literal sed syntax
        remaining="$(printf '%s' "$line" | sed -E 's/`+[^`]*`+//g')"
        while [[ "$remaining" =~ $link_pattern ]]; do
            match="${BASH_REMATCH[0]}"
            raw_destination="${BASH_REMATCH[1]}"
            # The anchor check may read this same file for a self-reference.
            # shellcheck disable=SC2094
            check_local_link "$file" "$rel" "$lineno" "$raw_destination"
            remaining="${remaining#*"$match"}"
        done
    done < "$file"
}

check_frontmatter() {
    local file="$1" rel="$2" field value

    for field in title updated verified; do
        value="$(frontmatter_field "$field" "$file" 2>/dev/null || echo "")"
        if [[ -z "$value" ]]; then
            err "$rel" 1 "frontmatter missing $field"
        elif [[ "$field" != "title" ]] \
            && [[ ! "$value" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
            err "$rel" 1 "$field is not a YYYY-MM-DD date: $value"
        fi
    done
}

check_section_metadata() {
    local file="$1" rel="$2" locator metadata_status supersedes
    local effective verified source source_values effective_epoch verified_epoch
    local current_locator cycle_reported=false
    declare -A supersedes_targets=()

    section_metadata_for_file "$rel" "$file"
    mapfile -t section_locators < <(printf '%s\n' "${!SECTION_META_STATUS[@]}" | sort -V)
    for locator in "${section_locators[@]}"; do
        [[ -n "$locator" ]] || continue
        metadata_status="${SECTION_META_STATUS[$locator]}"
        if [[ "${SECTION_META_VALID[$locator]}" != true ]]; then
            err "$rel" "$locator" \
                "section metadata invalid: ${SECTION_META_INVALID[$locator]}"
        fi

        supersedes="${SECTION_META_SUPERSEDES[$locator]}"
        if [[ "$metadata_status" == superseded && -n "$supersedes" ]]; then
            err "$rel" "$locator" \
                "superseded section must not declare supersedes; put the link on the newer section"
        elif [[ -n "$supersedes" ]]; then
            if [[ ! "$supersedes" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                err "$rel" "$locator" \
                    "invalid supersedes locator: $supersedes"
            elif [[ -z "${SECTION_META_STATUS[$supersedes]+present}" ]]; then
                err "$rel" "$locator" \
                    "supersedes section does not exist: $supersedes"
            elif [[ "$locator" == "$supersedes" ]]; then
                err "$rel" "$locator" \
                    "section cannot supersede itself: $locator"
            else
                supersedes_targets["$locator"]="$supersedes"
            fi
        fi

        effective="${SECTION_META_EFFECTIVE[$locator]}"
        verified="${SECTION_META_VERIFIED[$locator]}"
        if [[ -n "$effective" && -n "$verified" ]]; then
            effective_epoch="$(date_to_epoch "$effective")"
            verified_epoch="$(date_to_epoch "$verified")"
            if [[ -n "$effective_epoch" && -n "$verified_epoch" ]] \
                && (( effective_epoch > verified_epoch )); then
                err "$rel" "$locator" \
                    "effective date $effective is after verified date $verified"
            fi
        fi

        if [[ "${SECTION_META_SOURCE_SCOPE[$locator]}" == section ]]; then
            source_values="${SECTION_META_SOURCES[$locator]}"
            IFS=',' read -r -a section_sources <<< "$source_values"
            for source in "${section_sources[@]}"; do
                source="$(section_metadata_trim "$source")"
                [[ -n "$source" ]] || continue
                check_source_reference "$file" "$rel" "$locator" "$source"
            done
        fi
    done

    for locator in "${section_locators[@]}"; do
        [[ -n "$locator" ]] || continue
        declare -A chain_seen=()
        current_locator="$locator"
        while [[ -n "${supersedes_targets[$current_locator]+present}" ]]; do
            if [[ -n "${chain_seen[$current_locator]+present}" ]]; then
                if [[ "$cycle_reported" == false ]]; then
                    err "$rel" "$current_locator" \
                        "supersedes relationship contains a cycle"
                    cycle_reported=true
                fi
                break
            fi
            chain_seen["$current_locator"]=1
            current_locator="${supersedes_targets[$current_locator]}"
        done
    done
}

check_headings() {
    local file="$1" rel="$2"
    local line lineno=0 h1_count=0
    local h2_text="" h2_start=0 seen=""

    # close_h2 - Emit length and duplicate warnings for the open H2.
    close_h2() {
        local end="$1" len
        [[ -z "$h2_text" ]] && return 0
        len=$((end - h2_start + 1))
        if (( len > MAX_LINES )); then
            warn "$rel" "$h2_start" "H2 is $len lines (max $MAX_LINES): $h2_text"
        fi
        if printf '%s' "$seen" | grep -qxF "$h2_text"; then
            warn "$rel" "$h2_start" "duplicate H2 text: $h2_text"
        fi
        seen="$seen$h2_text
"
        h2_text=""
    }

    md_heading_reset
    while IFS= read -r line || [[ -n "$line" ]]; do
        lineno=$((lineno + 1))
        md_heading "$line" || continue

        if (( MD_HEADING_LEVEL <= 2 )); then
            close_h2 $((lineno - 1))
        fi

        if (( MD_HEADING_LEVEL == 1 )); then
            h1_count=$((h1_count + 1))
            if (( h1_count == 2 )); then
                err "$rel" "$lineno" \
                    "second H1 (one article, one H1): $MD_HEADING_TEXT"
            fi
        elif (( MD_HEADING_LEVEL == 2 )); then
            h2_text="$MD_HEADING_TEXT"
            h2_start=$lineno
        fi
    done < "$file"

    close_h2 "$lineno"

    if (( h1_count == 0 )); then
        err "$rel" 1 "no H1 (toc has no title for this file)"
    fi

    if [[ "$MD_FENCE_OPEN" == true ]]; then
        err "$rel" "$lineno" \
            "unclosed code fence (hides later headings from toc and section)"
    fi
}

for file in "${FILES[@]}"; do
    rel="${file#"$CONTENT_DIR/"}"
    check_frontmatter "$file" "$rel"
    check_headings "$file" "$rel"
    check_section_metadata "$file" "$rel"
    check_source_references "$file" "$rel"
    check_local_links "$file" "$rel"
done

echo ""
printf "%d file(s): %d error(s), %d warning(s)\n" \
    "${#FILES[@]}" "$errors" "$warnings"

if (( errors > 0 )); then
    exit 1
fi

if [[ "$STRICT" == true ]] && (( warnings > 0 )); then
    exit 1
fi
