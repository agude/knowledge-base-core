#!/usr/bin/env bash
#
# pending - List uncurated observations.
#
# Shows pending observations with their titles and dates.
# Use --full to include the body text.
# Use --preview for bounded queue metrics without body text.
#
# Usage:
#   pending [--full] [--count] [--preview]
#
# Options:
#   --full    Show full observation content, not just titles
#   --count   Just print the count
#   --preview Show batch-selectable queue metrics and lexical topic hints

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"
PENDING_DIR="$CONTENT_DIR/observations/pending"

FULL=false
COUNT_ONLY=false
PREVIEW=false

MAX_TOPIC_HINTS=8
MAX_METADATA_WARNINGS=8
MAX_TOPIC_HINT_LENGTH=120
MAX_METADATA_BYTES=65536
MAX_TOPIC_ARTICLES=256
TOPIC_SAMPLE_BYTES=8192

while [[ $# -gt 0 ]]; do
    case "$1" in
        --full)  FULL=true; shift ;;
        --count) COUNT_ONLY=true; shift ;;
        --preview) PREVIEW=true; shift ;;
        -h|--help)
            show_help "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ "$PREVIEW" == true ]] && [[ "$FULL" == true || "$COUNT_ONLY" == true ]]; then
    echo "--preview cannot be combined with --full or --count" >&2
    exit 1
fi

files=()
if [[ "$PREVIEW" == true ]]; then
    preview_files=()
    while IFS= read -r -d '' f; do
        preview_files+=("$f")
    done < <(find "$PENDING_DIR" -maxdepth 1 -name '*.md' -type f -print0 2>/dev/null | sort -z)
else
    while IFS= read -r -d '' f; do
        files+=("$f")
    done < <(find "$PENDING_DIR" -name '*.md' -type f -print0 2>/dev/null | sort -z)
fi

if [[ "$COUNT_ONLY" == true ]]; then
    echo "${#files[@]}"
    exit 0
fi

human_bytes() {
    local bytes="$1"

    if (( bytes < 1024 )); then
        printf "%d B" "$bytes"
    elif (( bytes < 1024 * 1024 )); then
        awk -v bytes="$bytes" 'BEGIN { printf "%.1f KiB", bytes / 1024 }'
    elif (( bytes < 1024 * 1024 * 1024 )); then
        awk -v bytes="$bytes" 'BEGIN { printf "%.1f MiB", bytes / 1048576 }'
    else
        awk -v bytes="$bytes" 'BEGIN { printf "%.1f GiB", bytes / 1073741824 }'
    fi
}

file_size() {
    local file="$1" size

    if size="$(stat -c '%s' "$file" 2>/dev/null)" && [[ "$size" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$size"
    elif size="$(stat -f '%z' "$file" 2>/dev/null)" && [[ "$size" =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$size"
    else
        wc -c < "$file" | awk '{print $1}'
    fi
}

normalise_text() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' |
        tr -cs '[:alnum:]' ' ' | tr -s ' '
}

article_topic_label() {
    local file="$1" line fallback_label=""
    local in_frontmatter=false

    md_heading_reset
    while IFS= read -r line; do
        if [[ "$line" == "---" ]]; then
            if [[ "$in_frontmatter" == false ]]; then
                in_frontmatter=true
            else
                in_frontmatter=false
            fi
            continue
        fi
        if md_heading "$line" && (( MD_HEADING_LEVEL == 1 )); then
            printf '%s\n' "$MD_HEADING_TEXT"
            return 0
        fi
        if [[ "$in_frontmatter" == true && "$line" =~ ^title:[[:space:]]*(.*)$ ]]; then
            fallback_label="${BASH_REMATCH[1]}"
            if [[ "$fallback_label" =~ ^\"(.*)\"$ ]]; then
                fallback_label="${BASH_REMATCH[1]}"
                fallback_label="${fallback_label//\\\\\"/\"}"
                fallback_label="${fallback_label//\\\\\\\\/\\\\}"
            fi
        fi
    done < <(head -c "$MAX_METADATA_BYTES" "$file")

    if [[ -n "$fallback_label" ]]; then
        printf '%s\n' "$fallback_label"
        return 0
    fi
    basename "$file" .md
}

bounded_topic_label() {
    local label="$1"

    if (( ${#label} > MAX_TOPIC_HINT_LENGTH )); then
        label="${label:0:117}..."
    fi
    printf '%s' "$label"
}

set_pending_metadata_field() {
    local field="$1" value="$2"

    if [[ "$value" =~ ^\"(.*)\"$ ]]; then
        value="${BASH_REMATCH[1]}"
        value="${value//\\\"/\"}"
        value="${value//\\\\/\\}"
    fi

    case "$field" in
        title)   PENDING_TITLE="$value" ;;
        source)  PENDING_SOURCE="$value" ;;
        created) PENDING_CREATED="$value" ;;
        topic)   PENDING_TOPIC="$value" ;;
    esac
}

read_pending_metadata() {
    local file="$1" line field value
    local in_frontmatter=false
    local metadata

    PENDING_TITLE=""
    PENDING_SOURCE=""
    PENDING_CREATED=""
    PENDING_TOPIC=""
    PENDING_FIRST_LINE=""
    PENDING_FRONTMATTER_COMPLETE=false

    metadata="$(head -c "$MAX_METADATA_BYTES" "$file")"
    PENDING_FIRST_LINE="${metadata%%$'\n'*}"

    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "---" ]]; then
            if [[ "$in_frontmatter" == false ]]; then
                in_frontmatter=true
            else
                PENDING_FRONTMATTER_COMPLETE=true
                break
            fi
            continue
        fi
        [[ "$in_frontmatter" == true ]] || continue

        if [[ "$line" =~ ^(title|source|created|topic):[[:space:]]*(.*)$ ]]; then
            field="${BASH_REMATCH[1]}"
            value="${BASH_REMATCH[2]}"
            set_pending_metadata_field "$field" "$value"
        fi
    done <<< "$metadata"
}

preview_queue() {
    local file source created created_date created_epoch size sample
    local today_epoch oldest_epoch="" oldest_date="" oldest_name=""
    local total_bytes=0 observation_count=0 transcript_count=0
    local observation_bytes=0 transcript_bytes=0
    local issue_text topic_hint normalized_topic
    local metadata_warning_count=0
    local -a metadata_warning_names=()
    local -a metadata_warning_details=()
    local -a topic_input_records=()
    local article label normalized_label pending_item_index=0
    local topic_article_count=0 topic_article_limit_reached=false

    today_epoch="${FRESHNESS_TODAY_EPOCH:-$(date -u +%s)}"

    if [[ -d "$CONTENT_DIR/knowledge" ]]; then
        while IFS= read -r -d '' article; do
            if (( topic_article_count >= MAX_TOPIC_ARTICLES )); then
                topic_article_limit_reached=true
                break
            fi
            topic_article_count=$((topic_article_count + 1))
            label="$(article_topic_label "$article")"
            [[ -n "$label" ]] || continue
            label="$(bounded_topic_label "$label")"
            normalized_label="$(normalise_text "$label")"
            [[ -n "$normalized_label" ]] || continue
            topic_input_records+=($'topic\t'"$normalized_label"$'\t'"$label")
        done < <(find "$CONTENT_DIR/knowledge" -name '*.md' -type f -print0 | sort -z)
    fi

    for file in "${preview_files[@]}"; do
        size="$(file_size "$file")"
        read_pending_metadata "$file"
        source="$PENDING_SOURCE"
        created="$PENDING_CREATED"
        total_bytes=$((total_bytes + size))
        pending_item_index=$((pending_item_index + 1))

        if [[ "$source" == "session-transcript" ]]; then
            transcript_count=$((transcript_count + 1))
            transcript_bytes=$((transcript_bytes + size))
        else
            observation_count=$((observation_count + 1))
            observation_bytes=$((observation_bytes + size))
        fi

        issue_text=""
        [[ "$PENDING_FIRST_LINE" == "---" && "$PENDING_FRONTMATTER_COMPLETE" == true ]] ||
            issue_text="malformed frontmatter"
        [[ -n "$PENDING_TITLE" ]] || issue_text="${issue_text:+$issue_text, }missing title"
        [[ -n "$source" ]] || issue_text="${issue_text:+$issue_text, }missing source"

        created_epoch=""
        if [[ -z "$created" ]]; then
            issue_text="${issue_text:+$issue_text, }missing created"
        else
            created_date="${created%%T*}"
            created_date="${created_date%% *}"
            if [[ ! "$created_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
                issue_text="${issue_text:+$issue_text, }invalid created"
            else
                created_epoch="$(date_to_epoch "$created_date")"
                [[ -n "$created_epoch" ]] || issue_text="${issue_text:+$issue_text, }invalid created"
            fi
        fi

        if [[ -n "$issue_text" ]]; then
            metadata_warning_count=$((metadata_warning_count + 1))
            if (( ${#metadata_warning_names[@]} < MAX_METADATA_WARNINGS )); then
                metadata_warning_names+=("$(basename "$file")")
                metadata_warning_details+=("$issue_text")
            fi
        fi

        if [[ -n "$created_epoch" ]]; then
            if [[ -z "$oldest_epoch" ]] || (( created_epoch < oldest_epoch )); then
                oldest_epoch="$created_epoch"
                oldest_date="$created_date"
                oldest_name="$(basename "$file")"
            fi
        fi

        topic_hint="$PENDING_TOPIC"
        if [[ -n "$topic_hint" ]]; then
            topic_hint="$(bounded_topic_label "$topic_hint")"
            normalized_topic="$(normalise_text "$topic_hint")"
            [[ -n "$normalized_topic" ]] &&
                topic_input_records+=($'direct\t'"$normalized_topic"$'\t'"$topic_hint"$'\t'"$pending_item_index")
        else
            # Dates and metadata keys are not topic evidence. Keep the bounded
            # title/body sample, even when the body is a large transcript.
            sample="$(head -c "$TOPIC_SAMPLE_BYTES" "$file" | awk '
                NR == 1 && $0 == "---" { frontmatter=1; next }
                frontmatter && $0 == "---" { frontmatter=0; next }
                !frontmatter { print }
            ')"
            sample="$PENDING_TITLE $sample"
            topic_input_records+=($'pending\t'"$pending_item_index"$'\t'"$(normalise_text "$sample")")
        fi
    done

    echo "Batch-selectable queue preview"
    echo "Batch-selectable items: ${#preview_files[@]}"
    if [[ -n "$oldest_epoch" ]]; then
        local age_seconds=$((today_epoch - oldest_epoch))
        local age_days=$((age_seconds / 86400))
        if (( age_seconds < 0 )); then
            local future_days=$(((-age_seconds + 86399) / 86400))
            echo "Oldest pending age: created in $future_days day(s) ($oldest_date; $oldest_name)"
        else
            echo "Oldest pending age: $age_days day(s) ($oldest_date; $oldest_name)"
        fi
    else
        echo "Oldest pending age: unknown (no valid created date)"
    fi
    printf "Observation items: %d (%s; %d bytes)\n" \
        "$observation_count" "$(human_bytes "$observation_bytes")" "$observation_bytes"
    printf "Transcript items: %d (%s; %d bytes)\n" \
        "$transcript_count" "$(human_bytes "$transcript_bytes")" "$transcript_bytes"
    printf "Input volume: %s (%d bytes)\n" "$(human_bytes "$total_bytes")" "$total_bytes"

    echo "Topic hints (hints only; no LLM):"
    if [[ "$topic_article_limit_reached" == true ]]; then
        echo "  topic article metadata capped at $MAX_TOPIC_ARTICLES file(s)"
    fi
    topic_hint_output="$(
        printf '%s\n' "${topic_input_records[@]}" |
            awk -F '\t' -v max="$MAX_TOPIC_HINTS" '
                function ignored_word(word) {
                    return word ~ /^(an|and|for|from|into|of|on|the|this|with|knowledge|article|setup|session|transcript|skill|system|guide)$/
                }
                function add_hint(label, display, item_id, key) {
                    if (label == "") {
                        return
                    }
                    key = label SUBSEP item_id
                    if (!(key in matched_items)) {
                        matched_items[key] = 1
                        file_count[label]++
                    }
                    score[label]++
                    if (!(label in display_name)) {
                        display_name[label] = display
                    }
                }
                function is_better(left_files, left_score, left_label, right_files, right_score, right_label) {
                    return left_files > right_files ||
                        (left_files == right_files &&
                            (left_score > right_score ||
                                (left_score == right_score && left_label < right_label)))
                }
                function consider(label, worst, i) {
                    if (top_count < max) {
                        top_count++
                        top_label[top_count] = label
                        top_files[top_count] = file_count[label]
                        top_score[top_count] = score[label]
                        return
                    }

                    worst = 1
                    for (i = 2; i <= top_count; i++) {
                        if (is_better(top_files[worst], top_score[worst], top_label[worst],
                                      top_files[i], top_score[i], top_label[i])) {
                            worst = i
                        }
                    }
                    if (is_better(file_count[label], score[label], label,
                                  top_files[worst], top_score[worst], top_label[worst])) {
                        top_label[worst] = label
                        top_files[worst] = file_count[label]
                        top_score[worst] = score[label]
                    }
                }
                $1 == "topic" {
                    label = $2
                    display_by_label[label] = $3
                    if (!(label in topic_seen)) {
                        topic_seen[label] = 1
                        word_count = split(label, words, / +/)
                        for (i = 1; i <= word_count; i++) {
                            word = words[i]
                            if (length(word) >= 3 && word !~ /^[0-9]+$/ && !ignored_word(word) &&
                                !((word SUBSEP label) in topic_words)) {
                                topic_words[word SUBSEP label] = 1
                                topic_word_count[label]++
                                if (word in labels_by_word) {
                                    labels_by_word[word] = labels_by_word[word] SUBSEP label
                                } else {
                                    labels_by_word[word] = label
                                }
                            }
                        }
                    }
                    next
                }
                $1 == "direct" {
                    add_hint($2, $3, $4)
                    next
                }
                $1 == "pending" {
                    item_id = $2
                    delete seen_words
                    delete label_matches
                    word_count = split($3, words, / +/)
                    for (i = 1; i <= word_count; i++) {
                        word = words[i]
                        if (word != "" && length(word) >= 3 &&
                            !(word in seen_words) && (word in labels_by_word)) {
                            seen_words[word] = 1
                            label_count = split(labels_by_word[word], labels, SUBSEP)
                            for (j = 1; j <= label_count; j++) {
                                label_matches[labels[j]]++
                            }
                        }
                    }
                    for (label in label_matches) {
                        required = topic_word_count[label] > 1 ? 2 : 1
                        if (label_matches[label] >= required) {
                            add_hint(label, display_by_label[label], item_id)
                        }
                    }
                    next
                }
                END {
                    for (label in file_count) {
                        consider(label)
                    }
                    for (i = 1; i <= top_count; i++) {
                        for (j = i + 1; j <= top_count; j++) {
                            if (is_better(top_files[j], top_score[j], top_label[j],
                                          top_files[i], top_score[i], top_label[i])) {
                                swap = top_label[i]
                                top_label[i] = top_label[j]
                                top_label[j] = swap
                                swap = top_files[i]
                                top_files[i] = top_files[j]
                                top_files[j] = swap
                                swap = top_score[i]
                                top_score[i] = top_score[j]
                                top_score[j] = swap
                            }
                        }
                    }
                    for (i = 1; i <= top_count; i++) {
                        printf "%d\t%d\t%s\n", top_files[i], top_score[i], display_name[top_label[i]]
                    }
                }
            '
    )"
    if [[ -z "$topic_hint_output" ]]; then
        echo "  none available"
    else
        while IFS=$'\t' read -r pending_count _ topic_label; do
            [[ -n "$topic_label" ]] || continue
            printf "  %s (%d pending item(s))\n" "$topic_label" "$pending_count"
        done <<< "$topic_hint_output"
    fi

    if (( ${#metadata_warning_names[@]} == 0 )); then
        echo "Metadata warnings: none"
    else
        echo "Metadata warnings: $metadata_warning_count malformed file(s)"
        for index in "${!metadata_warning_names[@]}"; do
            printf "  %s: %s\n" "${metadata_warning_names[index]}" "${metadata_warning_details[index]}"
        done
        if (( metadata_warning_count > ${#metadata_warning_names[@]} )); then
            echo "  ... $((metadata_warning_count - ${#metadata_warning_names[@]})) more malformed file(s)"
        fi
    fi
}

if [[ "$PREVIEW" == true ]]; then
    preview_queue
    exit 0
fi

if [[ ${#files[@]} -eq 0 ]]; then
    echo "No pending observations."
    exit 0
fi

echo "${#files[@]} pending observation(s):"
echo ""

for file in "${files[@]}"; do
    basename="$(basename "$file")"
    title="$(frontmatter_field "title" "$file" || echo "")"
    created="$(frontmatter_field "created" "$file" || echo "")"

    if [[ "$FULL" == true ]]; then
        echo "--- $basename ---"
        cat "$file"
        echo ""
    else
        printf "  %-30s  %s  [%s]\n" "$title" "$created" "$basename"
    fi
done
