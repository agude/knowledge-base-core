#!/usr/bin/env bash
#
# sync - Bring the content repo in line with its remote.
#
# Observations accumulate on whichever machine ran the session, and each
# machine commits them locally. Curation can only see what has reached
# one place, so the workflow is: sync on every machine, then curate on
# one. Doing that by hand is three commands and a decision about rebase
# vs merge; this is one command with the decision already made.
#
# Rebase, not merge: observation filenames are timestamped and unique, so
# concurrent machines never touch the same file and a rebase is always
# clean. Merge commits would just add noise to a log that is already
# mostly "Observe:".
#
# Runs under the same lock as the capture scripts, so a session cannot
# commit an observation in the middle of a rebase.
#
# Usage:
#   sync [--status]
#
# Options:
#   --status     Report what is ahead or behind; change nothing
#   --no-push    Pull only
#
# Exit status:
#   0  in sync (or successfully synced)
#   1  could not sync — uncommitted work, no remote, unverifiable remote,
#      or a failed rebase
#
# Examples:
#   sync              # pull, then push
#   sync --status     # what would it do?

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"

STATUS_ONLY=false
DO_PUSH=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --status)  STATUS_ONLY=true; shift ;;
        --no-push) DO_PUSH=false; shift ;;
        -h|--help)
            show_help "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ ! -d "$CONTENT_DIR/.git" ]]; then
    echo "Not a git repository: $CONTENT_DIR" >&2
    exit 1
fi

cd "$CONTENT_DIR"

stop_sync() {
    release_lock
    exit 1
}

abort_sync() {
    echo "$1" >&2
    stop_sync
}

assert_clean_worktree() {
    local dirty

    if ! dirty="$(git status --porcelain --untracked-files=all -- . \
        ':(exclude).observe.lock')"; then
        echo "Could not inspect the worktree in $CONTENT_DIR." >&2
        return 1
    fi

    if [[ -n "$dirty" ]]; then
        echo "Uncommitted changes in $CONTENT_DIR — commit or stash first:" >&2
        printf '%s\n' "$dirty" | sed -n '1,10p' >&2
        return 1
    fi
}

# The lock covers fetch, history inspection, and the worktree operations. A
# capture can write its pending file before it waits for this same lock, so
# the clean-worktree check must also run after fetch.
acquire_lock || exit 1

if ! git remote get-url origin > /dev/null 2>&1; then
    abort_sync "No 'origin' remote on $CONTENT_DIR — nothing to sync."
fi

if ! branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"; then
    abort_sync "Could not determine the current branch in $CONTENT_DIR."
fi

if ! assert_clean_worktree; then
    stop_sync
fi

if ! git fetch --quiet origin "$branch"; then
    abort_sync "Fetch failed; remote state could not be verified for origin/$branch."
fi

remote_ref="refs/remotes/origin/$branch"
if ! git rev-parse --verify --quiet "$remote_ref" > /dev/null; then
    abort_sync "Remote branch origin/$branch is unavailable; remote state could not be verified."
fi

if ! counts="$(git rev-list --left-right --count "$remote_ref...HEAD" 2>/dev/null)"; then
    abort_sync "Could not compare local and remote history; remote state could not be verified."
fi
if ! read -r behind ahead <<< "$counts"; then
    abort_sync "Could not parse local and remote history; remote state could not be verified."
fi
if [[ ! "$behind" =~ ^[0-9]+$ || ! "$ahead" =~ ^[0-9]+$ ]]; then
    abort_sync "Could not parse local and remote history; remote state could not be verified."
fi

# Recheck after fetch so an observation written while fetch was running is
# never mistaken for a clean, in-sync worktree.
if ! assert_clean_worktree; then
    stop_sync
fi

if [[ "$STATUS_ONLY" == true ]]; then
    if (( ahead == 0 && behind == 0 )); then
        echo "In sync with origin/$branch."
    else
        echo "$ahead to push, $behind to pull (origin/$branch)."
    fi
    release_lock
    exit 0
fi

if (( ahead == 0 && behind == 0 )); then
    echo "Already in sync with origin/$branch."
    release_lock
    exit 0
fi

rc=0
if (( behind > 0 )); then
    if ! assert_clean_worktree; then
        stop_sync
    fi
    echo "Pulling $behind commit(s)..."
    git rebase --quiet "$remote_ref" || rc=$?
    if (( rc != 0 )); then
        echo "Rebase failed. Resolve it in $CONTENT_DIR, then run sync again." >&2
        # Leave the rebase in place: aborting would discard the conflict
        # the user needs to see.
    fi
fi

if (( rc == 0 )) && [[ "$DO_PUSH" == true ]]; then
    if ! assert_clean_worktree; then
        rc=1
    elif ! pushing="$(git rev-list --count "$remote_ref..HEAD" 2>/dev/null)"; then
        echo "Could not determine commits to push; remote state could not be verified." >&2
        rc=1
    elif [[ ! "$pushing" =~ ^[0-9]+$ ]]; then
        echo "Could not determine commits to push; remote state could not be verified." >&2
        rc=1
    elif (( pushing > 0 )); then
        echo "Pushing $pushing commit(s)..."
        git push --quiet origin "$branch" || rc=$?
    fi
fi

release_lock

if (( rc != 0 )); then
    exit 1
fi

echo "Synced $CONTENT_DIR with origin/$branch."
