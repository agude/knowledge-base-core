#!/usr/bin/env bash
#
# observe - Record a new observation in the knowledge base.
#
# Creates a timestamped markdown file in observations/pending/ and
# auto-commits it. The body can come from --body or stdin.
#
# Usage:
#   observe --title "..." --body "..."
#   observe --title "..." --body - < file.txt
#
# Options:
#   --title TEXT   Observation title (required)
#   --body TEXT    Observation body (required). Use - to read stdin.
#   --source TEXT  Where this came from (default: "session")
#   --no-commit    Skip the auto-commit
#
# Examples:
#   observe --title "DNS caching issue" --body "Discovered that..."
#   observe --title "Meeting notes" --body - < /tmp/notes.txt
#   observe --title "Quick note" --body "Remember to check X"

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"
PENDING_DIR="$CONTENT_DIR/observations/pending"

TITLE=""
BODY=""
SOURCE="session"
DO_COMMIT=true
BODY_FILE=""
OBSERVATION_TEMP=""
LOCK_HELD=false

# acquire_lock and release_lock replace the EXIT trap, so this handler
# owns the lock too and is reinstalled after taking it.
cleanup() {
    [[ -z "$BODY_FILE" ]] || rm -f "$BODY_FILE"
    [[ -z "$OBSERVATION_TEMP" ]] || rm -f "$OBSERVATION_TEMP"
    if [[ "$LOCK_HELD" == true ]]; then
        rm -rf "$CONTENT_DIR/.observe.lock" 2>/dev/null || true
    fi
}
trap cleanup EXIT

while [[ $# -gt 0 ]]; do
    case "$1" in
        --title)     need_arg "$1" $#; TITLE="$2"; shift 2 ;;
        --body)      need_arg "$1" $#; BODY="$2"; shift 2 ;;
        --source)    need_arg "$1" $#; SOURCE="$2"; shift 2 ;;
        --no-commit) DO_COMMIT=false; shift ;;
        -h|--help)
            show_help "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ -z "$TITLE" ]]; then
    echo "Error: --title is required" >&2
    exit 1
fi

# Read body from stdin only when asked. Keep it in a file so trailing
# newlines and large transcripts do not pass through a command substitution.
if [[ "$BODY" == "-" ]]; then
    BODY_FILE="$(mktemp "${TMPDIR:-/tmp}/knowledge-observation.XXXXXX")" || {
        echo "Error: could not create a body buffer" >&2
        exit 1
    }
    cat > "$BODY_FILE" || {
        echo "Error: could not read observation body from stdin" >&2
        exit 1
    }
elif [[ -z "$BODY" ]]; then
    echo "Error: --body is required (use --body - to read stdin)" >&2
    exit 1
else
    BODY_FILE="$(mktemp "${TMPDIR:-/tmp}/knowledge-observation.XXXXXX")" || {
        echo "Error: could not create a body buffer" >&2
        exit 1
    }
    printf '%s' "$BODY" > "$BODY_FILE" || {
        echo "Error: could not buffer observation body" >&2
        exit 1
    }
fi

# Generate filename: YYYYMMDDTHHMMSS-<4 random chars>.md
timestamp="$(date -u +%Y%m%dT%H%M%S)"
# 8 hex digits, and od rather than xxd, which is not installed
# everywhere. A collision is a merge conflict on a content file, the
# exact thing timestamped filenames exist to avoid.
suffix="$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
filename="${timestamp}-${suffix}.md"
filepath="$PENDING_DIR/$filename"

# Write the observation. The final newline matches the existing Markdown
# format while the body file preserves any newlines supplied by the caller.
safe_title="$(yaml_escape "$TITLE")"
OBSERVATION_TEMP="$(mktemp "$PENDING_DIR/.observation.XXXXXX")" || {
    echo "Error: could not create an observation file" >&2
    exit 1
}
{
    # A group checked by || disables errexit; stop at the first failed write.
    printf '%s\n' '---' &&
    printf 'title: "%s"\n' "$safe_title" &&
    printf 'source: %s\n' "$SOURCE" &&
    printf 'created: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" &&
    printf '%s\n\n' '---' &&
    cat "$BODY_FILE" &&
    printf '\n'
} > "$OBSERVATION_TEMP" || {
    echo "Error: could not write observation file" >&2
    exit 1
}

# Take the lock before publishing. A writer that times out waiting then
# leaves nothing in pending/, so a caller that retries later (a session
# flush keeps its buffer) does not also leave an uncommitted duplicate.
if [[ "$DO_COMMIT" == true ]]; then
    acquire_lock || exit 1
    LOCK_HELD=true
    trap cleanup EXIT
fi

mv "$OBSERVATION_TEMP" "$filepath" || {
    echo "Error: could not publish observation file" >&2
    exit 1
}
OBSERVATION_TEMP=""

echo "Wrote: observations/pending/$filename"

if [[ "$DO_COMMIT" == true ]]; then
    commit_paths "Observe: $TITLE" "observations/pending/$filename"
fi
