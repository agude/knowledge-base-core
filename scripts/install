#!/usr/bin/env bash
#
# install - Wire hooks and skills into the system.
#
# Creates symlinks for coat-tree hooks and Claude Code skills.
# Idempotent — safe to re-run after updates.
#
# Usage:
#   install
#
# Locations:
#   Hooks:      ~/.config/coat-tree/hooks.d/<event>/010.knowledge
#   Skills:     ~/.claude/skills/<name>
#   Git hooks:  <content>/.git/hooks/pre-commit

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"

# Hooks must resolve against the deployed knowledge base (which has
# content/), not the infra repo. Use KNOWLEDGE_BASE when set; fall
# back to the repo this script lives in.
HOOK_SCRIPT_DIR="${KNOWLEDGE_BASE:+${KNOWLEDGE_BASE}/scripts}"
HOOK_SCRIPT_DIR="${HOOK_SCRIPT_DIR:-$SCRIPT_DIR}"

COAT_TREE_HOOKS="${XDG_CONFIG_HOME:-$HOME/.config}/coat-tree/hooks.d"
SKILLS_DIR="$HOME/.claude/skills"
HOOK_PREFIX="010.knowledge"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            awk 'NR==1{next} /^$/{exit} {sub(/^# ?/,""); print}' "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# --- Cleanup: remove every prior symlink pointing into this repo ---
#
# Anything currently linking into $REPO_ROOT was created by a previous
# run of this install. Whichever entries we still want will be recreated
# below; whichever we don't (renamed schemes, removed hooks) just stay
# gone. Clean slate is simpler than tracking which names are stale.

removed=0
for link in "${COAT_TREE_HOOKS}"/*/* "${SKILLS_DIR}"/*; do
    [[ -L "$link" ]] || continue
    target="$(readlink "$link")"
    case "$target" in
        "${REPO_ROOT}/"*|"${HOOK_SCRIPT_DIR}/"*)
            rm "$link"
            removed=$((removed + 1))
            ;;
    esac
done
if (( removed > 0 )); then
    echo "Removed $removed prior symlink(s)."
fi

# --- Hooks ---

HOOKS=(
    "PreToolUse:pretool-allow"
)

echo "Installing hooks..."
for pair in "${HOOKS[@]}"; do
    event="${pair%%:*}"
    script="${pair##*:}"
    mkdir -p "${COAT_TREE_HOOKS}/${event}"
    ln -sf "${HOOK_SCRIPT_DIR}/${script}" "${COAT_TREE_HOOKS}/${event}/${HOOK_PREFIX}"
    echo "  ${event}/${HOOK_PREFIX} → ${HOOK_SCRIPT_DIR}/${script}"
done

# --- Skills ---

echo "Installing skills..."
mkdir -p "$SKILLS_DIR"
for skill_dir in "$REPO_ROOT/skills/"*/; do
    [[ -d "$skill_dir" ]] || continue
    name="$(basename "$skill_dir")"
    ln -sfn "$skill_dir" "${SKILLS_DIR}/${name}"
    echo "  ${name}"
done

# --- Content repo git hooks ---
#
# Lints staged articles and stamps `updated:`. Skipped when the content
# repo does not exist yet; init calls this again after creating it.

if [[ -d "$CONTENT_DIR/.git" ]]; then
    echo "Installing content repo git hooks..."
    mkdir -p "$CONTENT_DIR/.git/hooks"
    ln -sfn "${SCRIPT_DIR}/hooks/pre-commit" "$CONTENT_DIR/.git/hooks/pre-commit"
    echo "  pre-commit"
fi

echo "Done."

# --- Environment reminder ---

if [[ -z "${KNOWLEDGE_BASE:-}" ]]; then
    echo ""
    echo "Note: KNOWLEDGE_BASE is not set in your shell."
    echo "  Add to your shell config:"
    echo "    export KNOWLEDGE_BASE=\"${REPO_ROOT}\""
fi
