#!/usr/bin/env bash
#
# install - Wire hooks and skills into the system.
#
# Creates symlinks for the shared skills and content-repo hook.
# Idempotent — safe to re-run after updates.
#
# Usage:
#   install
#
# Locations:
#   Skills:     ~/.agents/skills/<name>  (shared agent location)
#   Git hooks:  <content>/.git/hooks/pre-commit

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"

SKILL_DIRECTORIES=(
    "$HOME/.agents/skills"
)

LEGACY_HOOKS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/coat-tree/hooks.d"
LEGACY_HOOK_EVENTS=(
    "SessionStart"
    "UserPromptSubmit"
    "Stop"
    "SessionEnd"
    "PreToolUse"
)
LEGACY_HOOK_SCRIPTS=(
    "session-start"
    "session-prompt"
    "session-stop"
    "session-end"
    "pretool-allow"
)
LEGACY_HOOK_SCRIPT_DIR="${KNOWLEDGE_BASE:+${KNOWLEDGE_BASE}/scripts}"
LEGACY_HOOK_SCRIPT_DIR="${LEGACY_HOOK_SCRIPT_DIR:-$SCRIPT_DIR}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            awk 'NR==1{next} /^$/{exit} {sub(/^# ?/,""); print}' "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

# --- Migrate legacy Claude lifecycle hooks ---
#
# Before adapters existed, lifecycle scripts lived at scripts/<name> and
# install placed pretool-allow in coat-tree. Some installations also linked
# the lifecycle scripts directly. Replace only the known 010.knowledge links
# so unrelated coat-tree hooks remain untouched.

migrated=0
for index in "${!LEGACY_HOOK_EVENTS[@]}"; do
    event="${LEGACY_HOOK_EVENTS[$index]}"
    legacy_script="${LEGACY_HOOK_SCRIPTS[$index]}"
    link="$LEGACY_HOOKS_DIR/$event/010.knowledge"

    [[ -L "$link" ]] || continue
    target="$(readlink "$link")"
    case "$target" in
        "$SCRIPT_DIR/$legacy_script"|"$LEGACY_HOOK_SCRIPT_DIR/$legacy_script") ;;
        *) continue ;;
    esac

    adapter="$SCRIPT_DIR/adapters/claude/$legacy_script"
    if [[ ! -f "$adapter" ]]; then
        if rm "$link"; then
            migrated=$((migrated + 1))
        else
            echo "  warning: cannot remove legacy hook $link" >&2
        fi
        continue
    fi

    if ln -sfn "$adapter" "$link"; then
        migrated=$((migrated + 1))
    else
        echo "  warning: cannot migrate legacy hook $link" >&2
    fi
done
if (( migrated > 0 )); then
    echo "Migrated $migrated legacy Claude hook(s)."
fi

# --- Cleanup: remove prior skill symlinks pointing into this repo ---
#
# Anything currently linking into $REPO_ROOT was created by a previous
# run of this install. Whichever entries we still want will be recreated
# below; whichever we don't (renamed schemes, removed hooks) just stay
# gone. Clean slate is simpler than tracking which names are stale.

removed=0
for skills_dir in "${SKILL_DIRECTORIES[@]}"; do
    for link in "${skills_dir}"/*; do
        [[ -L "$link" ]] || continue
        target="$(readlink "$link")"
        case "$target" in
            "${REPO_ROOT}/"*)
                rm "$link" 2>/dev/null || true
                removed=$((removed + 1))
                ;;
        esac
    done
done
if (( removed > 0 )); then
    echo "Removed $removed prior skill symlink(s)."
fi

# --- Skills ---

echo "Installing skills..."
for skills_dir in "${SKILL_DIRECTORIES[@]}"; do
    if ! mkdir -p "$skills_dir" 2>/dev/null; then
        echo "  warning: cannot write skills at $skills_dir" >&2
        continue
    fi
    for skill_dir in "$REPO_ROOT/skills/"*/; do
        [[ -d "$skill_dir" ]] || continue
        name="$(basename "$skill_dir")"
        if ln -sfn "$skill_dir" "${skills_dir}/${name}"; then
            echo "  ${skills_dir}/${name}"
        else
            echo "  warning: cannot install ${skills_dir}/${name}" >&2
        fi
    done
done

# --- Content repo git hooks ---
#
# Lints staged articles and stamps `updated:`. Skipped when the content
# repo does not exist yet; init calls this again after creating it.

if [[ -d "$CONTENT_DIR/.git" ]]; then
    echo "Installing content repo git hooks..."
    mkdir -p "$CONTENT_DIR/.git/hooks"
    ln -sfn "${SCRIPT_DIR}/hooks/pre-commit" "$CONTENT_DIR/.git/hooks/pre-commit"
    echo "  pre-commit"
fi

echo "Done."

# --- Environment reminder ---

if [[ -z "${KNOWLEDGE_BASE:-}" ]]; then
    echo ""
    echo "Note: KNOWLEDGE_BASE is not set in your shell."
    echo "  Add to your shell config:"
    echo "    export KNOWLEDGE_BASE=\"${REPO_ROOT}\""
fi
