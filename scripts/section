#!/usr/bin/env bash
#
# section - Extract a section from a markdown file.
#
# Retrieves a section by H2 number (from `toc` output) or by heading text.
# Returns everything from the matched heading up to the next heading at the
# same or higher level.
#
# Usage:
#   section --file FILE (--number N | --heading TEXT | --top | --title) [--exact]
#           [--json | --text-only]
#   section --file FILE --references [--json]
#
# Options:
#   --file FILE      Markdown file to read (required)
#   --number N       H2 section number, or N.M for H3 under H2 N (from toc output)
#   --heading TEXT   Heading text to match (case-insensitive substring)
#   --top            Retrieve the prose before the first H2
#   --title          Retrieve the frontmatter title
#   --exact          Require exact heading match instead of substring
#   --json           Return one structured JSON object
#   --text-only      Return the historical section body without metadata
#   --references     Return the complete provenance reference list
#
# Examples:
#   section --file knowledge/networking.md --number 1     # 1st H2 section
#   section --file knowledge/networking.md --number 2     # 2nd H2 section
#   section --file knowledge/networking.md --number 2.1   # 1st H3 under 2nd H2
#   section --file knowledge/networking.md --heading 'DNS'  # any heading level
#   section --file knowledge/networking.md --top            # preamble and H1
#   section --file knowledge/networking.md --title          # frontmatter title
#
# Notes:
#   --number N targets H2s. --number N.M targets the Mth H3 under the Nth H2.
#   --heading matches any heading level (H2, H3, etc.), returning content up
#   to the next heading at the same or higher level.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"

FILE=""
NUMBER=""
HEADING=""
TOP=false
TITLE_ONLY=false
EXACT=false
JSON=false
TEXT_ONLY=false
REFERENCES_ONLY=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --file)    need_arg "$1" $#; FILE="$2"; shift 2 ;;
        --number)  need_arg "$1" $#; NUMBER="$2"; shift 2 ;;
        --heading) need_arg "$1" $#; HEADING="$2"; shift 2 ;;
        --top)     TOP=true; shift ;;
        --title)   TITLE_ONLY=true; shift ;;
        --exact)   EXACT=true; shift ;;
        --json)    JSON=true; shift ;;
        --text-only) TEXT_ONLY=true; shift ;;
        --references) REFERENCES_ONLY=true; shift ;;
        -h|--help)
            show_help "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ "$JSON" == true ]] && [[ "$TEXT_ONLY" == true ]]; then
    echo "Error: --json and --text-only cannot be combined" >&2
    exit 1
fi

if [[ -z "$FILE" ]]; then
    echo "Error: --file is required" >&2
    exit 1
fi

selector_count=0
[[ -n "$NUMBER" ]] && selector_count=$((selector_count + 1))
[[ -n "$HEADING" ]] && selector_count=$((selector_count + 1))
[[ "$TOP" == true ]] && selector_count=$((selector_count + 1))
[[ "$TITLE_ONLY" == true ]] && selector_count=$((selector_count + 1))
if (( selector_count > 1 )); then
    echo "Error: section selectors are mutually exclusive" >&2
    exit 1
fi

if [[ "$REFERENCES_ONLY" == true ]] && {
    [[ -n "$NUMBER" ]] || [[ -n "$HEADING" ]] || [[ "$TOP" == true ]] \
        || [[ "$TITLE_ONLY" == true ]] || [[ "$EXACT" == true ]] \
        || [[ "$TEXT_ONLY" == true ]];
}; then
    echo "Error: --references cannot be combined with section selectors or --text-only" >&2
    exit 1
fi

if [[ "$REFERENCES_ONLY" == false ]] && (( selector_count == 0 )); then
    echo "Error: provide --number N, --heading TEXT, --top, or --title" >&2
    exit 1
fi

if ! resolved="$(resolve_path "$FILE")"; then
    echo "File not found: $FILE" >&2
    exit 1
fi
FILE="$CONTENT_DIR/$resolved"

if [[ ! -f "$FILE" ]]; then
    echo "File not found: $FILE" >&2
    exit 1
fi

if [[ "$REFERENCES_ONLY" == true ]]; then
    retrieval_metadata_for_file "$resolved" "$FILE"
    if [[ "$JSON" == true ]]; then
        printf '{"path":'
        json_quote "$resolved"
        printf ',"corpus":'
        json_quote "$RESULT_CORPUS"
        printf ',"freshness":'
        json_freshness
        printf ',"conflict":'
        json_conflict
        printf ',"provenance":'
        json_provenance all
        printf '}\n'
    else
        printf '%s\n' "${PROVENANCE_REFERENCES[@]}"
    fi
    exit 0
fi

found=false
match_level=0
h2_count=0
h3_count=0
match_heading=""
match_number=""
match_level_number=""

BODY_FILE="$(mktemp "${TMPDIR:-/tmp}/knowledge-section.XXXXXX")" || {
    echo "Error: could not create temporary section output" >&2
    exit 1
}
cleanup() { rm -f "$BODY_FILE"; }
trap cleanup EXIT

# Parse dot notation: "2.3" means H2 #2, H3 #3 under it
TARGET_H2=""
TARGET_H3=""
if [[ -n "$NUMBER" ]]; then
    if [[ "$NUMBER" == *.* ]]; then
        TARGET_H2="${NUMBER%%.*}"
        TARGET_H3="${NUMBER#*.}"
    else
        TARGET_H2="$NUMBER"
    fi
fi

# For heading matching, lowercase the query
if [[ -n "$HEADING" ]]; then
    heading_lower="$(printf '%s' "$HEADING" | tr '[:upper:]' '[:lower:]')"
fi

if [[ "$TITLE_ONLY" == true ]]; then
    if ! match_heading="$(frontmatter_field title "$FILE")" || [[ -z "$match_heading" ]]; then
        echo "Title not found" >&2
        exit 1
    fi
    found=true
    printf '%s\n' "$match_heading" >> "$BODY_FILE"
elif [[ "$TOP" == true ]]; then
    in_frontmatter=false
    first_line=true
    md_heading_reset
    while IFS= read -r line; do
        if [[ "$first_line" == true ]] && [[ "$line" == "---" ]]; then
            in_frontmatter=true
            first_line=false
            continue
        fi
        first_line=false
        if [[ "$in_frontmatter" == true ]]; then
            [[ "$line" == "---" ]] && in_frontmatter=false
            continue
        fi
        if md_heading "$line" && (( MD_HEADING_LEVEL == 2 )); then
            break
        fi
        printf '%s\n' "$line" >> "$BODY_FILE"
    done < "$FILE"
    found=true
    match_heading="top"
else
    md_heading_reset
    while IFS= read -r line; do
    if md_heading "$line"; then
        title="$MD_HEADING_TEXT"
        level="$MD_HEADING_LEVEL"

        if [[ "$found" == true ]]; then
            # Inside matched section. Stop at same or higher level heading.
            if (( level <= match_level )); then
                break
            fi
            printf '%s\n' "$line" >> "$BODY_FILE"
            continue
        fi

        # Count H2s and H3s for --number matching
        if (( level == 2 )); then
            h2_count=$((h2_count + 1))
            h3_count=0
        elif (( level == 3 )); then
            h3_count=$((h3_count + 1))
        fi

        # Check for match
        matched=false

        if [[ -n "$TARGET_H2" ]]; then
            if [[ -n "$TARGET_H3" ]]; then
                # Dot notation: match H3 under specific H2
                if (( level == 3 )) && (( h2_count == TARGET_H2 )) && (( h3_count == TARGET_H3 )); then
                    matched=true
                fi
            else
                # Plain number: match H2
                if (( level == 2 )) && (( h2_count == TARGET_H2 )); then
                    matched=true
                fi
            fi
        elif [[ -n "$HEADING" ]]; then
            title_lower="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]')"
            if [[ "$EXACT" == true ]]; then
                [[ "$title_lower" == "$heading_lower" ]] && matched=true
            else
                [[ "$title_lower" == *"$heading_lower"* ]] && matched=true
            fi
        fi

        if [[ "$matched" == true ]]; then
            found=true
            match_level=$level
            match_heading="$title"
            match_level_number="$level"
            if (( level == 2 )); then
                match_number="$h2_count"
            elif (( level == 3 )); then
                match_number="$h2_count.$h3_count"
            fi
            printf '%s\n' "$line" >> "$BODY_FILE"
        fi
    else
        if [[ "$found" == true ]]; then
            printf '%s\n' "$line" >> "$BODY_FILE"
        fi
    fi
    done < "$FILE"
fi

if [[ "$found" == false ]]; then
    if [[ -n "$TARGET_H2" ]]; then
        echo "Section #${NUMBER} not found (file has ${h2_count} H2 sections)" >&2
    else
        echo "Heading not found: '$HEADING'" >&2
    fi
    exit 1
fi

retrieval_metadata_for_file "$resolved" "$FILE"

if [[ "$TEXT_ONLY" == true ]]; then
    cat "$BODY_FILE"
    exit 0
fi

if [[ "$JSON" == true ]]; then
    printf '{"path":'
    json_quote "$resolved"
    printf ',"corpus":'
    json_quote "$RESULT_CORPUS"
    printf ',"locator":{"number":'
    if [[ -n "$match_number" ]]; then
        json_quote "$match_number"
    else
        printf 'null'
    fi
    printf ',"heading":'
    json_quote "$match_heading"
    if [[ "$TOP" == true ]]; then
        printf ',"command":"--top"'
    elif [[ "$TITLE_ONLY" == true ]]; then
        printf ',"command":"--title"'
    fi
    printf ',"level":'
    if [[ -n "$match_level_number" ]]; then printf '%s' "$match_level_number"; else printf 'null'; fi
    printf '},"freshness":'
    json_freshness
    printf ',"conflict":'
    json_conflict
    printf ',"provenance":'
    json_provenance
    printf ',"content":'
    json_quote_file "$BODY_FILE"
    printf '}\n'
    exit 0
fi

if [[ "$TOP" == true ]]; then
    locator="--top"
elif [[ "$TITLE_ONLY" == true ]]; then
    locator="--title"
elif [[ -n "$match_number" ]]; then
    locator="$match_number"
else
    locator="heading"
fi
if [[ -n "$match_level_number" ]]; then
    printf 'Metadata: path=%s; corpus=%s; locator=%s "%s" (H%s)\n' \
        "$resolved" "$RESULT_CORPUS" "$locator" "$match_heading" "$match_level_number"
else
    printf 'Metadata: path=%s; corpus=%s; locator=%s "%s"\n' \
        "$resolved" "$RESULT_CORPUS" "$locator" "$match_heading"
fi
printf 'Freshness: '
freshness_metadata_text
printf '\n'
conflict_metadata_text
printf 'Provenance: scope=%s; %s\n' "$PROVENANCE_SCOPE" \
    "$(provenance_metadata_text)"
printf -- '---\n'
cat "$BODY_FILE"
