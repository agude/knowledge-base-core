#!/usr/bin/env bash
#
# session-flush - Convert a session buffer into a raw observation.
#
# Reads the session JSONL (user prompts + assistant responses), formats
# it as a readable transcript, and saves it as a single observation.
# The curator handles extraction and judgment later.
#
# Transcripts shorter than KNOWLEDGE_MIN_MESSAGES (default 3) are
# dropped. A third of every transcript ever captured here was a single
# question and its answer, and that noise is paid for twice: once in the
# content repo's history and once in the curator's attention. The filter
# is mechanical on purpose — nothing here judges content, because
# whatever a weak filter discards is invisible to the curator forever.
#
# The cost is real: a one-exchange session that happened to contain a
# durable fact is now lost unless the agent called `observe` explicitly,
# which is what it is supposed to do anyway. Set
# KNOWLEDGE_MIN_MESSAGES=0 to keep everything.
#
# Called by host adapters and by session-init when it sweeps orphaned files.
#
# Usage:
#   session-flush <session-file>

set -euo pipefail

# session-flush is only called when observation was enabled for the session.
# Export so observe (and any other callees) see it.
export KNOWLEDGE_OBSERVE=1

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SESSION_FILE="${1:-}"

if [[ -z "$SESSION_FILE" ]] || [[ ! -f "$SESSION_FILE" ]]; then
    exit 0
fi

# Skip empty files
if [[ ! -s "$SESSION_FILE" ]]; then
    rm -f "$SESSION_FILE"
    exit 0
fi

MIN_MESSAGES="${KNOWLEDGE_MIN_MESSAGES:-3}"

# Count first: a transcript below the threshold is not worth building.
TURN_COUNT="$(grep -c '"role"' "$SESSION_FILE" 2>/dev/null || echo 0)"

if (( TURN_COUNT < MIN_MESSAGES )); then
    logger -t knowledge \
        "session-flush: dropping $TURN_COUNT-message transcript (min $MIN_MESSAGES)" \
        2>/dev/null || true
    rm -f "$SESSION_FILE"
    exit 0
fi

# Build a readable transcript from the JSONL
TRANSCRIPT=""
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    [[ "$line" != \{* ]] && continue

    ROLE="$(echo "$line" | jq -r '.role // empty' 2>/dev/null)"
    MESSAGE="$(echo "$line" | jq -r '.message // empty' 2>/dev/null)"

    if [[ -n "$ROLE" ]] && [[ -n "$MESSAGE" ]]; then
        TRANSCRIPT="${TRANSCRIPT}### ${ROLE}

${MESSAGE}

"
    fi
done < "$SESSION_FILE"

if [[ -z "$TRANSCRIPT" ]]; then
    rm -f "$SESSION_FILE"
    exit 0
fi

# Save as a single observation
if "$SCRIPT_DIR/observe" \
    --title "Session transcript (${TURN_COUNT} messages)" \
    --body "$TRANSCRIPT" \
    --source "session-transcript" \
    2>/dev/null; then
    rm -f "$SESSION_FILE"
else
    echo "session-flush: observe failed, keeping $SESSION_FILE" >&2
fi
