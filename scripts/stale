#!/usr/bin/env bash
#
# stale - List knowledge articles past their freshness threshold.
#
# Reads the `verified` date from each article's frontmatter and compares
# it against today. Articles are grouped by staleness severity.
#
# Usage:
#   stale [--days N] [--path DIR] [--count]
#
# Options:
#   --days N     Override threshold: flag anything older than N days
#   --path DIR   Scope to a subdirectory of knowledge/
#   --count      Print only the number of articles needing attention
#
# Examples:
#   stale                        # use default thresholds
#   stale --days 30              # flag anything not verified in 30 days
#   stale --path knowledge/deploys/
#
# Per-article thresholds come from a `ttl:` field in the frontmatter,
# either a number of days or one of these names:
#
#   people    14 days  — people, roles, org structure
#   status    14 days  — active initiatives, project status
#   process   60 days  — processes and workflows
#   domain   180 days  — domain rules and system behavior
#
# Content type cannot be auto-detected, so an article with no `ttl:`
# falls back to 60 days. The curator sets it when writing the article;
# that is the only place the type is actually known.
#
# Files under sources/ are local copies of external documents, so their
# freshness is `synced:` — when the copy was last pulled — rather than
# `verified:`.
#
# --days overrides everything, for a one-off review at a chosen depth.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
source "$SCRIPT_DIR/_lib.sh"

CUSTOM_DAYS=""
TARGET=""
COUNT_ONLY=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --days) need_arg "$1" $#; CUSTOM_DAYS="$2"; shift 2 ;;
        --path) need_arg "$1" $#; TARGET="$2"; shift 2 ;;
        --count) COUNT_ONLY=true; shift ;;
        -h|--help)
            show_help "$0"
            exit 0
            ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

if [[ -z "$TARGET" ]]; then
    TARGET="$CONTENT_DIR/knowledge"
else
    resolved="$(resolve_path "$TARGET")" && TARGET="$CONTENT_DIR/$resolved"
fi

if [[ ! -d "$TARGET" ]]; then
    echo "Not found: $TARGET" >&2
    exit 1
fi

DEFAULT_DAYS=60

# ttl_days - Map a `ttl:` value to a number of days.
#
# Prints nothing for an unrecognized value, so the caller can fall back.
ttl_days() {
    case "$1" in
        people|status)  echo 14 ;;
        process)        echo 60 ;;
        domain)         echo 180 ;;
        ''|*[!0-9]*)    echo "" ;;
        *)              echo "$1" ;;
    esac
}

# Get today as seconds since epoch (portable across GNU and BSD date)
today_epoch="$(date -u +%s)"

# date_to_epoch - Convert YYYY-MM-DD to seconds since epoch.
# Works with both GNU date (-d) and BSD date (-j -f).
date_to_epoch() {
    local d="$1"
    # Try GNU date first
    date -u -d "$d" +%s 2>/dev/null && return
    # Fall back to BSD date
    date -u -j -f "%Y-%m-%d" "$d" +%s 2>/dev/null && return
    echo ""
}

stale_count=0
no_date_count=0

while IFS= read -r -d '' file; do
    relpath="${file#"$CONTENT_DIR/"}"

    # sources/ holds copies of external documents; `synced:` is when the
    # copy was pulled, which is what goes stale about it.
    if [[ "$relpath" == sources/* ]]; then
        date_field="synced"
    else
        date_field="verified"
    fi
    verified="$(frontmatter_field "$date_field" "$file" 2>/dev/null || echo "")"

    if [[ -z "$verified" ]]; then
        no_date_count=$((no_date_count + 1))
        if [[ "$COUNT_ONLY" == false ]]; then
            echo "  [no $date_field]  $relpath"
        fi
        continue
    fi

    # Parse the verified date (handle YYYY-MM-DD, strip any time component)
    verified_date="${verified%T*}"
    verified_epoch="$(date_to_epoch "$verified_date")"

    if [[ -z "$verified_epoch" ]]; then
        no_date_count=$((no_date_count + 1))
        if [[ "$COUNT_ONLY" == false ]]; then
            echo "  [bad date] $relpath  (verified: $verified)"
        fi
        continue
    fi

    if [[ -n "$CUSTOM_DAYS" ]]; then
        threshold_days="$CUSTOM_DAYS"
    else
        ttl="$(frontmatter_field "ttl" "$file" 2>/dev/null || echo "")"
        threshold_days="$(ttl_days "$ttl")"
        threshold_days="${threshold_days:-$DEFAULT_DAYS}"
    fi
    threshold_secs=$((threshold_days * 86400))
    age_secs=$((today_epoch - verified_epoch))
    age_days=$((age_secs / 86400))

    if (( age_secs > threshold_secs )); then
        stale_count=$((stale_count + 1))
        if [[ "$COUNT_ONLY" == false ]]; then
            printf "  %4d days  %s  (%s: %s, ttl %sd)\n" \
                "$age_days" "$relpath" "$date_field" "$verified_date" \
                "$threshold_days"
        fi
    fi

done < <(find "$TARGET" -name '*.md' -type f -print0 | sort -z)

total=$((stale_count + no_date_count))

if [[ "$COUNT_ONLY" == true ]]; then
    echo "$total"
    exit 0
fi

if (( total == 0 )); then
    echo "No stale articles."
else
    echo ""
    echo "$stale_count stale, $no_date_count missing date."
fi
